strict digraph {
  graph [rankdir=LR, overlap=false, splines=true, pad=0.25, nodesep=0.35, ranksep=0.55];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#475569", fontname="Helvetica", fontsize=10];
  edge [color="#94A3B8", arrowsize=0.7, penwidth=1.0];
  label="Remora Dependency Graph (LSP Internal Only)";
  labelloc=t;
  fontsize=16;
  "remora.lsp";
  "remora.lsp.__main__";
  "remora.lsp.db";
  "remora.lsp.graph";
  "remora.lsp.handlers.actions";
  "remora.lsp.handlers.capabilities";
  "remora.lsp.handlers.commands";
  "remora.lsp.handlers.documents";
  "remora.lsp.handlers.hover";
  "remora.lsp.handlers.lens";
  "remora.lsp.models";
  "remora.lsp.notifications";
  "remora.lsp.process_lock";
  "remora.lsp.runner";
  "remora.lsp.server";
  "remora.lsp.tools";
  "remora.lsp" -> "remora.lsp.db";
  "remora.lsp" -> "remora.lsp.graph";
  "remora.lsp" -> "remora.lsp.models";
  "remora.lsp" -> "remora.lsp.server";
  "remora.lsp.__main__" -> "remora.lsp.process_lock";
  "remora.lsp.__main__" -> "remora.lsp.server";
  "remora.lsp.graph" -> "remora.lsp.db";
  "remora.lsp.handlers.actions" -> "remora.lsp";
  "remora.lsp.handlers.actions" -> "remora.lsp.models";
  "remora.lsp.handlers.capabilities" -> "remora.lsp";
  "remora.lsp.handlers.commands" -> "remora.lsp";
  "remora.lsp.handlers.documents" -> "remora.lsp";
  "remora.lsp.handlers.documents" -> "remora.lsp.models";
  "remora.lsp.handlers.hover" -> "remora.lsp";
  "remora.lsp.handlers.lens" -> "remora.lsp";
  "remora.lsp.notifications" -> "remora.lsp";
  "remora.lsp.notifications" -> "remora.lsp.models";
  "remora.lsp.server" -> "remora.lsp.db";
  "remora.lsp.server" -> "remora.lsp.graph";
  "remora.lsp.server" -> "remora.lsp.handlers.actions";
  "remora.lsp.server" -> "remora.lsp.handlers.capabilities";
  "remora.lsp.server" -> "remora.lsp.handlers.commands";
  "remora.lsp.server" -> "remora.lsp.handlers.documents";
  "remora.lsp.server" -> "remora.lsp.handlers.hover";
  "remora.lsp.server" -> "remora.lsp.handlers.lens";
  "remora.lsp.server" -> "remora.lsp.notifications";
}
