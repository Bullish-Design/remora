  "remora.core.agents.cairn_bridge";
  "remora.core.agents.cairn_externals";
  "remora.core.agents.chat";
  "remora.core.agents.execution" [fillcolor="#FEE2E2", color="#B91C1C", penwidth=2.2, fontcolor="#7F1D1D"];
  "remora.core.agents.kernel_factory";
  "remora.core.agents.swarm_executor";
  "remora.core.agents.workspace";
  "remora.core.code.discovery";
