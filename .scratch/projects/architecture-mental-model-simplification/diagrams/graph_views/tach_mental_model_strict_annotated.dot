  "remora.core.agents.swarm_executor" -> "remora.core.events.events" [color="#DC2626", penwidth=1.5];
  "remora.core.agents.swarm_executor" -> "remora.core.events.subscriptions";
  "remora.core.agents.swarm_executor" -> "remora.core.store.event_store";
