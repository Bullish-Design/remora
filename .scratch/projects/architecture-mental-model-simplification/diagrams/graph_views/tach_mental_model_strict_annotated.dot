  "remora.core.store.event_store" -> "remora.core.agents.agent_node";
  "remora.core.store.event_store" -> "remora.core.events.events" [color="#DC2626", penwidth=1.5];
  "remora.core.tools" -> "remora.core.agents.agent_context";
