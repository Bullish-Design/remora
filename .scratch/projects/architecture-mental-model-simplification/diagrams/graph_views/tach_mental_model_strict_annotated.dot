  "remora.core.tools" -> "remora.core.events.events" [color="#DC2626", penwidth=1.5];
  "remora.core.tools" -> "remora.core.events.subscriptions";
  "remora.lsp.db" -> "remora.core.code.discovery";
  "remora.lsp.graph" -> "remora.core.store.event_store";
  "remora.lsp.graph" -> "remora.lsp.db";
  "remora.lsp.server" -> "remora.core.agents.agent_node" [color="#DC2626", penwidth=1.5];
  "remora.lsp.server" -> "remora.core.code.discovery" [color="#DC2626", penwidth=1.5];
  "remora.lsp.server" -> "remora.core.config" [color="#DC2626", penwidth=1.5];
  "remora.lsp.server" -> "remora.core.events.events" [color="#DC2626", penwidth=1.5];
  "remora.lsp.server" -> "remora.core.tools" [color="#DC2626", penwidth=1.5];
  "remora.lsp.server" -> "remora.lsp.db" [color="#DC2626", penwidth=1.5];
  "remora.lsp.server" -> "remora.lsp.graph" [color="#DC2626", penwidth=1.5];
  "remora.runner.agent_runner" -> "remora.core.agents.agent_node" [color="#DC2626", penwidth=1.5];
  "remora.runner.agent_runner" -> "remora.core.agents.cairn_bridge" [color="#DC2626", penwidth=1.5];
  "remora.runner.agent_runner" -> "remora.core.agents.execution" [color="#DC2626", penwidth=1.5];
  "remora.runner.agent_runner" -> "remora.core.config" [color="#DC2626", penwidth=1.5];
  "remora.runner.agent_runner" -> "remora.core.events.events" [color="#DC2626", penwidth=1.5];
  "remora.runner.agent_runner" -> "remora.runner.protocols" [color="#DC2626", penwidth=1.5];
  "remora.service.api" -> "remora.core.agents.cairn_bridge" [color="#DC2626", penwidth=1.5];
  "remora.service.api" -> "remora.core.code.projections" [color="#DC2626", penwidth=1.5];
  "remora.service.api" -> "remora.core.config" [color="#DC2626", penwidth=1.5];
  "remora.service.api" -> "remora.core.events.event_bus" [color="#DC2626", penwidth=1.5];
  "remora.service.api" -> "remora.core.events.subscriptions" [color="#DC2626", penwidth=1.5];
  "remora.service.api" -> "remora.core.store.event_store" [color="#DC2626", penwidth=1.5];
  "remora.service.api" -> "remora.service.handlers" [color="#DC2626", penwidth=1.5];
  "remora.service.api" -> "remora.ui.projector" [color="#DC2626", penwidth=1.5];
  "remora.service.api" -> "remora.ui.view" [color="#DC2626", penwidth=1.5];
  "remora.service.handlers" -> "remora.core.code.discovery";
  "remora.service.handlers" -> "remora.core.config";
  "remora.service.handlers" -> "remora.core.events.event_bus";
  "remora.service.handlers" -> "remora.core.events.events" [color="#DC2626", penwidth=1.5];
  "remora.service.handlers" -> "remora.core.store.event_store";
  "remora.service.handlers" -> "remora.ui.projector";
  "remora.ui.projector" -> "remora.core.events.events" [color="#DC2626", penwidth=1.5];

  subgraph cluster_legend {
    label="Hotspot Legend";
    fontsize=12;
    color="#D1D5DB";
    style="rounded,dashed";
    legend_hot [label="Hotspot module", shape=box, style="rounded,filled", fillcolor="#FEE2E2", color="#B91C1C", penwidth=2.2, fontcolor="#7F1D1D"];
    legend_norm [label="Normal module", shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#475569"];
    legend_hot -> legend_norm [label="related dependency", color="#DC2626", fontcolor="#7F1D1D"];
  }

  "hs_note_1" [shape=note, style="filled", fillcolor="#FFF7ED", color="#C2410C", fontcolor="#7C2D12", label="H1: Event hub\nHigh inbound coupling\n(full graph: in=29, out=1, degree=30)"];
  "hs_note_1" -> "remora.core.events.events" [style=dashed, color="#C2410C", penwidth=1.2, arrowhead=normal];
  "hs_note_2" [shape=note, style="filled", fillcolor="#FFF7ED", color="#C2410C", fontcolor="#7C2D12", label="H2: LSP orchestrator\nFan-out + cross-boundary\n(full graph: in=2, out=15, degree=17)"];
  "hs_note_2" -> "remora.lsp.server" [style=dashed, color="#C2410C", penwidth=1.2, arrowhead=normal];
  "hs_note_3" [shape=note, style="filled", fillcolor="#FFF7ED", color="#C2410C", fontcolor="#7C2D12", label="H3: Core execution orchestrator\nMany direct deps\n(full graph: in=4, out=13, degree=17)"];
  "hs_note_3" -> "remora.core.agents.execution" [style=dashed, color="#C2410C", penwidth=1.2, arrowhead=normal];
  "hs_note_4" [shape=note, style="filled", fillcolor="#FFF7ED", color="#C2410C", fontcolor="#7C2D12", label="H4: Service composition root\nTouches many subsystems\n(full graph: in=3, out=13, degree=16)"];
  "hs_note_4" -> "remora.service.api" [style=dashed, color="#C2410C", penwidth=1.2, arrowhead=normal];
  "hs_note_5" [shape=note, style="filled", fillcolor="#FFF7ED", color="#C2410C", fontcolor="#7C2D12", label="H5: Runner integration hub\nBridges core + protocols\n(full graph: in=4, out=10, degree=14)"];
  "hs_note_5" -> "remora.runner.agent_runner" [style=dashed, color="#C2410C", penwidth=1.2, arrowhead=normal];
}
