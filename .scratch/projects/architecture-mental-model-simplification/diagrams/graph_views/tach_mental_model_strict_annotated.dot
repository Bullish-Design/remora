strict digraph {
  graph [rankdir=LR, overlap=false, splines=true, pad=0.25, nodesep=0.38, ranksep=0.62, bgcolor="#FFFFFF"];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#475569", fontname="Helvetica", fontsize=10];
  edge [color="#B0BCCB", arrowsize=0.7, penwidth=0.9];
  label="Remora Dependency Graph (Mental-Model Strict, Annotated Hotspots)";
  labelloc=t;
  fontsize=16;

  "remora.cli.workspace";
  "remora.companion.dispatcher";
  "remora.companion.events";
  "remora.companion.indexing_service";
  "remora.companion.startup";
  "remora.companion.state";
  "remora.core.agents";
  "remora.core.agents.agent_context";
