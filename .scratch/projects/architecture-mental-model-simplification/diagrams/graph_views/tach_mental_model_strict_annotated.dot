  "remora.core.agents.execution" -> "remora.core.agents.kernel_factory" [color="#DC2626", penwidth=1.5];
  "remora.core.agents.execution" -> "remora.core.agents.workspace" [color="#DC2626", penwidth=1.5];
  "remora.core.agents.execution" -> "remora.core.code.discovery" [color="#DC2626", penwidth=1.5];
  "remora.core.agents.execution" -> "remora.core.events.events" [color="#DC2626", penwidth=1.5];
