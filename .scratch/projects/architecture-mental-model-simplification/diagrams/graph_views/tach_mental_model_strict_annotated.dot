  "remora.core.events.subscriptions";
  "remora.core.store.event_store";
  "remora.core.tools";
  "remora.lsp.db";
  "remora.lsp.graph";
  "remora.lsp.models";
  "remora.lsp.server" [fillcolor="#FEE2E2", color="#B91C1C", penwidth=2.2, fontcolor="#7F1D1D"];
  "remora.runner.agent_runner" [fillcolor="#FEE2E2", color="#B91C1C", penwidth=2.2, fontcolor="#7F1D1D"];
  "remora.runner.protocols";
  "remora.service.api" [fillcolor="#FEE2E2", color="#B91C1C", penwidth=2.2, fontcolor="#7F1D1D"];
  "remora.service.handlers";
  "remora.ui.projector";
  "remora.ui.view";

  "remora.cli.workspace" -> "remora.core.agents.workspace";
  "remora.companion.dispatcher" -> "remora.companion.events";
  "remora.companion.dispatcher" -> "remora.companion.state";
  "remora.companion.dispatcher" -> "remora.core.events.events" [color="#DC2626", penwidth=1.5];
  "remora.companion.events" -> "remora.core.events.events" [color="#DC2626", penwidth=1.5];
  "remora.companion.indexing_service" -> "remora.companion.events";
  "remora.companion.startup" -> "remora.companion.dispatcher";
  "remora.companion.startup" -> "remora.companion.events";
  "remora.companion.startup" -> "remora.companion.indexing_service";
  "remora.companion.startup" -> "remora.companion.state";
