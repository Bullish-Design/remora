strict digraph {
  graph [rankdir=LR, overlap=false, splines=true, pad=0.25, nodesep=0.35, ranksep=0.55];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#475569", fontname="Helvetica", fontsize=10];
  edge [color="#94A3B8", arrowsize=0.7, penwidth=1.0];
  label="Remora Dependency Graph (Package-Level)";
  labelloc=t;
  fontsize=16;
  "remora.__main__";
  "remora.adapters";
  "remora.cli";
  "remora.companion";
  "remora.core";
  "remora.extensions";
  "remora.lsp";
  "remora.models";
  "remora.runner";
  "remora.service";
  "remora.ui";
  "remora.utils";
  "remora.workspace";
  "remora.__main__" -> "remora.cli";
  "remora.adapters" -> "remora.service";
  "remora.cli" -> "remora.adapters";
  "remora.cli" -> "remora.core";
  "remora.cli" -> "remora.extensions";
  "remora.cli" -> "remora.lsp";
  "remora.cli" -> "remora.runner";
  "remora.cli" -> "remora.service";
  "remora.cli" -> "remora.workspace";
  "remora.companion" -> "remora.core";
  "remora.core" -> "remora.utils";
  "remora.lsp" -> "remora.core";
  "remora.lsp" -> "remora.extensions";
  "remora.lsp" -> "remora.runner";
  "remora.models" -> "remora.core";
  "remora.runner" -> "remora.core";
  "remora.runner" -> "remora.extensions";
  "remora.service" -> "remora.core";
  "remora.service" -> "remora.extensions";
  "remora.service" -> "remora.models";
  "remora.service" -> "remora.ui";
  "remora.service" -> "remora.utils";
  "remora.ui" -> "remora.core";
}
